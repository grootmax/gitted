{
  "name": "gitted",
  "version": "1.0.0",
  "description": "Dynamic fan-out dampening, inverse reference frequency scoring, regex fallback parser, parse status indicator, Git move tracking, and AST symbol fingerprinting",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grootmax/gitted.git"
  },
  "keywords": [
    "vscode",
    "context",
    "sqlite",
    "ast",
    "git",
    "static-analysis",
    "code-graph",
    "ast-parser",
    "fallback-parser",
    "context-builder",
    "scoring-engine",
    "fan-out-dampening",
    "git-move-tracking",
    "ast-fingerprinting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "vitest": "^3.0.7"
  }
}
